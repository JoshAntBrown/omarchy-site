---
import Base from '../layouts/Base.astro'
import { HomeIsland } from '../astro/islands'
import { getNewsIndex, getPluginHighlights } from '../astro/data'
import { headProps } from '../astro/head'
import { homeSeo } from '../astro/page-seo'

const [highlights, news] = await Promise.all([getPluginHighlights(), getNewsIndex()])
const data = { ...highlights, news }
const head = headProps(homeSeo(), '/')
---
<Base {...head}>
  <HomeIsland client:load data={data} />
</Base>
