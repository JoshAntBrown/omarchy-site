---
import Base from '../layouts/Base.astro'
import { PortedIsland } from '../astro/islands'
import { getPortedPage, getPortedSlugs } from '../astro/data'
import { headProps } from '../astro/head'
import { portedSeo } from '../astro/page-seo'

// /teams/ has a dedicated page; it wins over the catch-all.
export function getStaticPaths() {
  return getPortedSlugs()
    .filter((slug) => slug !== 'teams')
    .map((slug) => ({ params: { slug }, props: { slug } }))
}

const { slug } = Astro.params
const page = getPortedPage(slug ?? '')
if (!page) throw new Error(`Ported page not found: ${slug}`)
const head = headProps(portedSeo(page, slug ?? ''), `/${slug}/`)
---
<Base {...head}>
  <PortedIsland client:load data={page} slug={slug ?? ''} />
</Base>
